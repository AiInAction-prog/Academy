# TopstepX / ProjectX credentials — copy to .env and fill in real values.
# .env is gitignored; never commit it.

TSX_USERNAME=your_topstepx_username
API_KEY=your_topstepx_api_key

# live = combine/funded (api.topstepx.com) | demo = paper gateway
TSX_ENV=live

# Set per-run via $env:ACCOUNT_ID or here. Find IDs: python discover-accounts.py
# ACCOUNT_ID=

# true = local simulation only | false = live sim orders on TopstepX
PAPER_MODE=true
