# TopstepX / ProjectX credentials. Copy this file to .env and fill in your own values.
# .env is gitignored; never commit it. Never share or post your API key.
# PRACTICE ACCOUNT ONLY. This code refuses any account that isn't your TopStep Practice account.

TSX_USERNAME=your_topstepx_username
API_KEY=your_topstepx_api_key

# live = the TopstepX gateway (api.topstepx.com), where your Practice account lives.
TSX_ENV=live

# Your Practice account id (name starts with PRAC). Find it: python discover-accounts.py
# Leave blank to use your Practice account automatically.
# ACCOUNT_ID=

# true = local simulation only | false = orders sent to your TopStep Practice account
PAPER_MODE=true
